<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
  </PropertyGroup>
	
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>	

  <ItemGroup>
	<PackageReference Include="Fanex.Data.SqlServer" Version="4.3.1" />
    <PackageReference Include="Fanex.Logging" Version="2.0.1.1" />
    <PackageReference Include="MediatR" Version="12.4.1" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="9.0.0" />
	<PackageReference Include="AsyncKeyedLock" Version="7.1.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Fanex.CommonAPI.Domain\Fanex.CommonAPI.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Commands\" />
  </ItemGroup>

  <ItemGroup>
	<SonarQubeSetting Include="sonar.coverage.exclusions">
	  <Value>**/DependencyInjection.cs, **/AssemblyReference.cs</Value>
	</SonarQubeSetting>
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Resources\ViewResources.Product.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>ViewResources.Product.resx</DependentUpon>
    </Compile>
    <Compile Update="Resources\ViewResources.ProductById.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>ViewResources.ProductById.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Resources\ViewResources.Product.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>ViewResources.Product.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <EmbeddedResource Update="Resources\ViewResources.ProductById.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>ViewResources.ProductById.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

</Project>
